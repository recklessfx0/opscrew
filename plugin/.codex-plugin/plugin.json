{
  "name": "opscrew",
  "version": "0.2.12",
  "description": "OpsCrew: the ops crew you didn't hire. Scan your app for security problems, plan a deployment that fits your budget, prepare the code and deploy to your own cloud with Terraform or OpenTofu, with your approval at every step.",
  "skills": "./skills/",
  "mcpServers": {
    "opscrew": {
      "command": "npx",
      "args": ["-y", "opscrew@0.2.12", "mcp"],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 1800,
      "env": { "OPSCREW_MCP_CLIENT": "codex" },
      "env_vars": [
        "HCLOUD_TOKEN",
        "DIGITALOCEAN_TOKEN",
        "DIGITALOCEAN_ACCESS_TOKEN",
        "CNTB_OAUTH2_CLIENT_ID",
        "CNTB_OAUTH2_CLIENT_SECRET",
        "CNTB_OAUTH2_USER",
        "CNTB_OAUTH2_PASS",
        "OVH_ENDPOINT",
        "OVH_CLIENT_ID",
        "OVH_CLIENT_SECRET",
        "OVH_CLOUD_PROJECT_SERVICE",
        "KAMATERA_API_CLIENT_ID",
        "KAMATERA_API_SECRET",
        "UPCLOUD_TOKEN",
        "CLOUDFLARE_API_TOKEN",
        "OPSCREW_CLOUDFLARE_DEPLOY_TOKEN",
        "OPSCREW_NEW_CLOUDFLARE_API_TOKEN",
        "GITHUB_TOKEN",
        "GH_TOKEN",
        "OPSCREW_GHCR_READ_TOKEN",
        "PORTAINER_API_KEY",
        "GODADDY_API_TOKEN",
        "NAMECHEAP_API_USER",
        "NAMECHEAP_API_KEY",
        "NAMECHEAP_USERNAME",
        "NAMECHEAP_CLIENT_IP",
        "PORKBUN_API_KEY",
        "PORKBUN_SECRET_API_KEY",
        "OPSCREW_HOSTING_URL",
        "OPSCREW_HOSTING_USER",
        "OPSCREW_HOSTING_TOKEN",
        "OPSCREW_SFTP_HOST",
        "OPSCREW_SFTP_USER",
        "OPSCREW_SFTP_KEY",
        "OPSCREW_BESZEL_TOKEN",
        "OPSCREW_GRAFANA_CLOUD_TOKEN",
        "OPSCREW_CHECK_WEBHOOK",
        "OPSCREW_CHECK_NTFY_TOKEN",
        "OPSCREW_APP_ENV_FILE",
        "OPSCREW_STORAGE_ACCESS_KEY_ID",
        "OPSCREW_STORAGE_SECRET_ACCESS_KEY",
        "OPSCREW_OFFSITE_ACCESS_KEY_ID",
        "OPSCREW_OFFSITE_SECRET_ACCESS_KEY",
        "OPSCREW_OFFSITE_SFTP_KEY",
        "OPSCREW_HOME"
      ]
    }
  },
  "interface": {
    "displayName": "OpsCrew",
    "shortDescription": "Scan, plan, prepare and deploy your app to your own cloud, with your approval at every step.",
    "developerName": "OpsCrew",
    "category": "Developer Tools",
    "websiteURL": "https://opscrew.dev"
  }
}
